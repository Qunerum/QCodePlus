. ; db - 255 - 8B - 2H
. ; dw - 65 535 - 16B - 4H
. ; dd - 4 294 967 295 - 32B - 8H
. ; dq - 18 446 744 073 709 551 615 - 64B - 16H

. ; sm - start main
. ; em - end main
. ; step - function
. ; es - end function
. ; call - call
. ; prt - print text
. ; prtn - print number
. ; prti - print int
. ; prtln - print line
. ; add - add int
. ; sub - sub int
. ; mul - mul int
. ; div - div int

. ; QCode Plus v. 0.0.9
data
	int x 15
	text print_0 "Hello, World!"
end

. ; main
sm
	t. sub rsp, 16            ; int y and z
	t. mov dword [rsp], 7     ; int y = 7;
	t. mov dword [rsp+8], 2   ; int z = 2;

	t. mov eax, [rsp]         ; x += y;
	t. add dword [rel x], eax ; x += y;

	t. mov eax, [rsp+8]       ; x += z;
	t. add dword [rel x], eax ; x += z;


em

step test
	t. ; print("Hello, World!", 10);
	prt print_0
	prtln
	prti x
es=
