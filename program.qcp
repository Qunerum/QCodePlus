use(text)

int x(0)
func main()
	str test(64, "Hello")
	for(i, 4)
		text add(test, " ")
		text add(test, "...")
	end
	println(s:test)
	text shift(test, 2)
	println("shift 2:\n'", s:test, "'")
	text shift(test, -8)
	println("shift -3:\n'", s:test, "'")
	text trimc(test, '.')
	println("trimc '.':\n'", s:test, "'")
	text trim(test)
	println("trim:\n'", s:test, "'")
end
